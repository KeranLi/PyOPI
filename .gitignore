# Git Ignore File for OPI Project

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# PyCharm / VSCode
.idea/
.vscode/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# ============================================
# MATLAB
# ============================================
*.asv
*.m~
*.mat

# ============================================
# Output files (generated by running code)
# ============================================
# Large result files
*.npz
*.nc
*.tif
*.tiff

# PDF outputs
*.pdf

# Example outputs (can be regenerated)
examples/output/
OPI_python/examples/output/
OPI_matlab/runs/figs/

# Logs
*.log
*_Log.txt

# ============================================
# Data files (optional - keep if small)
# ============================================
# Uncomment to ignore sample data
# *.xlsx
# *.csv

# ============================================
# OS files
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# Documentation builds
# ============================================
docs/_build/
docs/_static/
docs/_templates/

# ============================================
# Test coverage
# ============================================
.coverage
htmlcov/
.pytest_cache/
.tox/

# ==========================================
# Temporary files
# ==========================================
tmp/
temp/
*.tmp
